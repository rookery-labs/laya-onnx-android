{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>rookery-labs/.github"
  ],
  "enabledManagers": ["cargo"],
  "packageRules": [
    {
      "matchDatasources": ["crate"],
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true,
      "automergeType": "pr",
      "ignoreTests": false
    }
  ]
}
